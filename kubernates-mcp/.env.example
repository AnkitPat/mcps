# HTTP listener exposed by the deployment platform.
PORT=8080
# The externally reachable HTTPS origin, without a trailing slash.
MCP_PUBLIC_URL=https://kubernetes-mcp.example.com

# Production authentication: an OIDC provider such as Auth0, Okta, or Entra ID.
AUTH_MODE=oidc
OIDC_ISSUER=https://your-tenant.example.com
OIDC_AUDIENCE=kubernetes-mcp
OIDC_REQUIRED_SCOPE=kubernetes.read

# Local-only alternative. Do not use a shared static token in production.
# AUTH_MODE=token
# MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Kubernetes service-account credentials. Grant only the read permissions the tools need.
K8S_API_SERVER=https://your-cluster.example.com:443
K8S_API_TOKEN=replace-with-a-service-account-token
# K8S_API_CA=base64-encoded-ca-certificate
